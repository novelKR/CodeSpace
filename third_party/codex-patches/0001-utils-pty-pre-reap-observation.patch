+/// Output the child wrote before it exited still drains while the child is unreaped.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn the_output_drains_while_the_child_is_unreaped() -> anyhow::Result<()> {
+    const BYTES: usize = 262_144;
+    for path in PATHS {
+        let (spawned, observed) = spawn_observed(
+            &format!("head -c {BYTES} /dev/zero | tr '\\0' x"),
+            path,
+            PATIENCE,
+        )
+        .await?;
+        let SpawnedProcess {
+            mut stdout_rx,
+            exit_rx,
+            ..
+        } = spawned;
+        let Observed {
+            opportunity,
+            outcome,
+        } = observed;
+        let drained = tokio::spawn(async move {
+            let mut count = 0;
+            while count < BYTES
+                && let Some(chunk) = stdout_rx.recv().await
+            {
+                count += chunk.iter().filter(|byte| **byte == b'x').count();
+            }
+            count
+        });
+
+        let opportunity = timeout(PATIENCE, opportunity).await??;
+        opportunity.acknowledge()?;
+        assert_eq!(timeout(PATIENCE, exit_rx).await??, 0, "{path:?}");
+        assert_eq!(
+            timeout(PATIENCE, outcome).await??,
+            ObservationOutcome::Completed,
+            "{path:?}"
+        );
+        assert_eq!(timeout(PATIENCE, drained).await??, BYTES, "{path:?}");
+    }
+    Ok(())
+}
+
+/// An observer that never acknowledges holds a shutdown of the spawning runtime for the bound,
+/// and no longer.
+#[test]
+fn a_runtime_shutdown_in_the_window_waits_only_for_the_bound() -> anyhow::Result<()> {
+    let bound = Duration::from_millis(500);
+    for path in PATHS {
+        let runtime = tokio::runtime::Builder::new_multi_thread()
+            .worker_threads(1)
+            .enable_all()
+            .build()?;
+        let (spawned, observed) = runtime.block_on(spawn_observed("exit 0", path, bound))?;
+        let Observed {
+            opportunity,
+            outcome,
+        } = observed;
+        let opportunity = runtime.block_on(async { timeout(PATIENCE, opportunity).await })??;
+
+        let started = Instant::now();
+        drop(spawned);
+        runtime.shutdown_timeout(PATIENCE);
+        let held = started.elapsed();
+        assert!(
+            held >= bound - Duration::from_millis(100),
+            "{path:?} {held:?}"
+        );
+        assert!(held < PATIENCE / 2, "{path:?} {held:?}");
+
+        assert_eq!(
+            outcome.blocking_recv()?,
+            ObservationOutcome::TimedOut,
+            "{path:?}"
+        );
+        assert_eq!(
+            opportunity.acknowledge(),
+            Err(OpportunityExpired),
+            "{path:?}"
+        );
+    }
+    Ok(())
+}
