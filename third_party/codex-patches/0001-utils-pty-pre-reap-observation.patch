+// Added by the CodeSpace project (https://github.com/novelKR/CodeSpace) as a downstream patch
+// to rust-v0.154.0: bounded observation of an exited child before its reap. Not part of
+// upstream Codex.
+
+//! Bounded observation of an exited child before it is reaped.
+//!
+//! A PTY spawn that registers an [`ExitObserver`] keeps its single waiter. When the child
+//! exits, the waiter sees the exit without consuming its status (`waitid` with `WNOWAIT`), so
+//! the child stays a zombie that still holds its process ID and process group ID. The waiter
+//! then publishes one [`ExitOpportunity`] and waits until the observer acknowledges it or the
+//! bound fixed at registration passes, whichever comes first. Only then does it reap the child,
+//! through the same child object as without an observer, and report how the observation ended.
+//! The opportunity carries no process ID: an observer that needs the process's identity takes
+//! it from its own records.
+//!
+//! Without a registration the waiter behaves exactly as before.
+
+use std::fmt;
+use std::sync::Arc;
+use std::sync::Condvar;
+use std::sync::Mutex;
+use std::time::Duration;
+use std::time::Instant;
+
+use tokio::sync::oneshot;
+
+/// How an observation ended. Reported once, after the child has been reaped.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ObservationOutcome {
+    /// The observer acknowledged the opportunity before the bound.
+    Completed,
+    /// The bound passed first; the child was reaped without an acknowledgement.
+    TimedOut,
+    /// The observer could not take the opportunity, or dropped it without acknowledging.
+    Failed,
+    /// The exit could not be seen without reaping, so no opportunity was published.
+    Unavailable,
+}
+
+/// Registered with an observed spawn, before the child exists.
+#[derive(Debug)]
+pub struct ExitObserver {
+    /// Gets the one opportunity once the child has exited, before it is reaped. Dropped unsent
+    /// when no opportunity can be published.
+    pub opportunity: oneshot::Sender<ExitOpportunity>,
+    /// How long the waiter keeps the exited child unreaped for the observer.
+    pub bound: Duration,
+    /// Gets how the observation ended, once the child has been reaped.
+    pub outcome: oneshot::Sender<ObservationOutcome>,
+}
+
+/// One chance to observe an exited child before it is reaped. Dropping it without
+/// acknowledging ends the observation as [`ObservationOutcome::Failed`].
+pub struct ExitOpportunity {
+    window: Arc<Window>,
+}
+
+impl fmt::Debug for ExitOpportunity {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("ExitOpportunity").finish()
+    }
+}
+
+impl ExitOpportunity {
+    /// Let the waiter reap the child now. Refused once the bound has passed.
+    pub fn acknowledge(self) -> Result<(), OpportunityExpired> {
+        self.window.close(WindowState::Acknowledged)
+    }
+}
+
+impl Drop for ExitOpportunity {
+    fn drop(&mut self) {
+        let _ = self.window.close(WindowState::Abandoned);
+    }
+}
+
+/// Returned when an opportunity is acknowledged after its bound had passed.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct OpportunityExpired;
+
+impl fmt::Display for OpportunityExpired {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("the exit opportunity's bound had already passed")
+    }
+}
+
+impl std::error::Error for OpportunityExpired {}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum WindowState {
+    Open,
+    Acknowledged,
+    Abandoned,
+    Expired,
+}
+
+struct Window {
+    state: Mutex<WindowState>,
+    changed: Condvar,
+}
+
+impl Window {
+    /// Close an open window as `state`; refused when it was already closed.
+    fn close(&self, state: WindowState) -> Result<(), OpportunityExpired> {
+        let Ok(mut current) = self.state.lock() else {
+            return Err(OpportunityExpired);
+        };
+        if *current != WindowState::Open {
+            return Err(OpportunityExpired);
+        }
+        *current = state;
+        self.changed.notify_all();
+        Ok(())
+    }
+
+    /// Wait until the window is closed or `deadline` passes, which expires it.
+    fn wait(&self, deadline: Instant) -> ObservationOutcome {
+        let Ok(mut state) = self.state.lock() else {
+            return ObservationOutcome::Failed;
+        };
+        loop {
+            match *state {
+                WindowState::Acknowledged => return ObservationOutcome::Completed,
+                WindowState::Abandoned => return ObservationOutcome::Failed,
+                WindowState::Expired => return ObservationOutcome::TimedOut,
+                WindowState::Open => {
+                    let now = Instant::now();
+                    if now >= deadline {
+                        *state = WindowState::Expired;
+                        return ObservationOutcome::TimedOut;
+                    }
+                    state = match self.changed.wait_timeout(state, deadline - now) {
+                        Ok((state, _)) => state,
+                        Err(_) => return ObservationOutcome::Failed,
+                    };
+                }
+            }
+        }
+    }
+}
+
+/// The observed waiter body: wait until the child `pid` has exited without reaping it, publish
+/// the opportunity, and wait for the acknowledgement or the bound. Whatever happens, then reap
+/// the child once through `reap`, as without an observer, and report the outcome.
+pub(crate) fn observed_wait<T>(
+    pid: Option<u32>,
+    observer: ExitObserver,
+    reap: impl FnOnce() -> T,
+) -> T {
+    let ExitObserver {
+        opportunity: publish,
+        bound,
+        outcome: report,
+    } = observer;
+    let outcome = match pid.map(wait_exited_unreaped) {
+        Some(Ok(())) => {
+            let window = Arc::new(Window {
+                state: Mutex::new(WindowState::Open),
+                changed: Condvar::new(),
+            });
+            let opportunity = ExitOpportunity {
+                window: Arc::clone(&window),
+            };
+            // A refused opportunity comes back and is dropped, which abandons the window.
+            match publish.send(opportunity) {
+                Ok(()) => window.wait(Instant::now() + bound),
+                Err(_) => ObservationOutcome::Failed,
+            }
+        }
+        Some(Err(_)) | None => ObservationOutcome::Unavailable,
+    };
+    let status = reap();
+    let _ = report.send(outcome);
+    status
+}
+
+/// Block until the child `pid` has exited, leaving it waitable for its own waiter.
+#[cfg(unix)]
+fn wait_exited_unreaped(pid: u32) -> std::io::Result<()> {
+    loop {
+        // SAFETY: an all-zero `siginfo_t` is a valid value for `waitid` to fill.
+        let mut info: libc::siginfo_t = unsafe { std::mem::zeroed() };
+        // SAFETY: `info` is valid for writes; `WNOWAIT` leaves the child's status unconsumed.
+        let result = unsafe {
+            libc::waitid(
+                libc::P_PID,
+                pid as libc::id_t,
+                &mut info,
+                libc::WEXITED | libc::WNOWAIT,
+            )
+        };
+        if result == 0 {
+            return Ok(());
+        }
+        let err = std::io::Error::last_os_error();
+        if err.kind() != std::io::ErrorKind::Interrupted {
+            return Err(err);
+        }
+    }
+}
+
+/// Exits cannot be seen without reaping here.
+#[cfg(not(unix))]
+fn wait_exited_unreaped(_pid: u32) -> std::io::Result<()> {
+    Err(std::io::ErrorKind::Unsupported.into())
+}
+
