+// Added by the CodeSpace project (https://github.com/novelKR/CodeSpace) as a downstream patch
+// to rust-v0.154.0. Not part of upstream Codex.
+
+use std::collections::HashMap;
+use std::fs::File;
+use std::os::fd::AsRawFd;
+use std::path::Path;
+use std::time::Duration;
+use std::time::Instant;
+
+use pretty_assertions::assert_eq;
+use tokio::sync::mpsc;
+use tokio::sync::oneshot;
+use tokio::time::timeout;
+
+use super::ExitObserver;
+use super::ExitOpportunity;
+use super::ObservationOutcome;
+use super::OpportunityExpired;
+use crate::SpawnedProcess;
+use crate::TerminalSize;
+use crate::spawn_pty_process_observed;
+
+const PATIENCE: Duration = Duration::from_secs(10);
+
+/// The two Unix spawn paths: without inherited descriptors, and preserving one.
+#[derive(Clone, Copy, Debug)]
+enum SpawnPath {
+    Portable,
+    PreservingFds,
+}
+
+const PATHS: [SpawnPath; 2] = [SpawnPath::Portable, SpawnPath::PreservingFds];
+
+/// The observer's ends of an observed spawn.
+struct Observed {
+    opportunity: oneshot::Receiver<ExitOpportunity>,
+    outcome: oneshot::Receiver<ObservationOutcome>,
+}
+
+async fn spawn_observed(
+    script: &str,
+    path: SpawnPath,
+    bound: Duration,
+) -> anyhow::Result<(SpawnedProcess, Observed)> {
+    let env: HashMap<String, String> = std::env::vars().collect();
+    let (opportunity_tx, opportunity) = oneshot::channel();
+    let (outcome_tx, outcome) = oneshot::channel();
+    let observer = ExitObserver {
+        opportunity: opportunity_tx,
+        bound,
+        outcome: outcome_tx,
+    };
+    let devnull = File::open("/dev/null")?;
+    let inherited_fds = match path {
+        SpawnPath::Portable => Vec::new(),
+        SpawnPath::PreservingFds => vec![devnull.as_raw_fd()],
+    };
+    let spawned = spawn_pty_process_observed(
+        "/bin/sh",
+        &["-c".to_string(), script.to_string()],
+        Path::new("."),
+        &env,
+        &None,
+        TerminalSize::default(),
+        &inherited_fds,
+        observer,
+    )
+    .await?;
+    Ok((
+        spawned,
+        Observed {
+            opportunity,
+            outcome,
+        },
+    ))
+}
+
+/// Read the child's output until it has printed each of `markers` followed by a number and a
+/// line end, and return those numbers in order.
+async fn marker_pids<const N: usize>(
+    output: &mut mpsc::Receiver<Vec<u8>>,
+    markers: [&str; N],
+) -> anyhow::Result<[i32; N]> {
+    let mut collected = String::new();
+    loop {
+        let found = markers.map(|marker| {
+            let start = collected.find(marker)?;
+            let rest = &collected[start + marker.len()..];
+            let digits: String = rest.chars().take_while(char::is_ascii_digit).collect();
+            (!digits.is_empty() && rest.len() > digits.len())
+                .then(|| digits.parse::<i32>().ok())
+                .flatten()
+        });
+        if found.iter().all(Option::is_some) {
+            return Ok(found.map(Option::unwrap_or_default));
+        }
+        let chunk = timeout(PATIENCE, output.recv())
+            .await?
+            .ok_or_else(|| anyhow::anyhow!("output ended before {markers:?}: {collected:?}"))?;
+        collected.push_str(&String::from_utf8_lossy(&chunk));
+    }
+}
+
+/// Whether this process's child `pid` has exited and is still unreaped.
+fn exited_unreaped(pid: i32) -> bool {
+    // SAFETY: an all-zero `siginfo_t` is a valid value for `waitid` to fill.
+    let mut info: libc::siginfo_t = unsafe { std::mem::zeroed() };
+    // SAFETY: `info` is valid for writes; `WNOWAIT` leaves the child's status unconsumed.
+    let result = unsafe {
+        libc::waitid(
+            libc::P_PID,
+            pid as libc::id_t,
+            &mut info,
+            libc::WEXITED | libc::WNOHANG | libc::WNOWAIT,
+        )
+    };
+    // SAFETY: `waitid` filled `info`, or left the zero it was given.
+    result == 0 && unsafe { info.si_pid() } == pid
+}
+
+/// Whether `pid` is no longer this process's child to wait for: it has been reaped.
+fn reaped(pid: i32) -> bool {
+    // SAFETY: an all-zero `siginfo_t` is a valid value for `waitid` to fill.
+    let mut info: libc::siginfo_t = unsafe { std::mem::zeroed() };
+    // SAFETY: `info` is valid for writes; `WNOWAIT` leaves any status unconsumed.
+    let result = unsafe {
+        libc::waitid(
+            libc::P_PID,
+            pid as libc::id_t,
+            &mut info,
+            libc::WEXITED | libc::WNOHANG | libc::WNOWAIT,
+        )
+    };
+    result == -1 && std::io::Error::last_os_error().raw_os_error() == Some(libc::ECHILD)
+}
+
+fn alive(pid: i32) -> bool {
+    // SAFETY: signal 0 only checks that `pid` can be signalled.
+    unsafe { libc::kill(pid, 0) == 0 }
+}
+
+async fn ended(pid: i32) -> bool {
+    let deadline = Instant::now() + PATIENCE;
+    while alive(pid) {
+        if Instant::now() >= deadline {
+            return false;
+        }
+        tokio::time::sleep(Duration::from_millis(20)).await;
+    }
+    true
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn the_observer_sees_the_exit_before_the_reap() -> anyhow::Result<()> {
+    for path in PATHS {
+        let (spawned, observed) = spawn_observed("echo pid:$$; exit 3", path, PATIENCE).await?;
+        let SpawnedProcess {
+            session,
+            mut stdout_rx,
+            exit_rx,
+            ..
+        } = spawned;
+        let Observed {
+            opportunity,
+            outcome,
+        } = observed;
+        let [pid] = marker_pids(&mut stdout_rx, ["pid:"]).await?;
+
+        let opportunity = timeout(PATIENCE, opportunity).await??;
+        assert!(exited_unreaped(pid), "{path:?}");
+        assert!(!session.has_exited(), "{path:?}");
+
+        opportunity.acknowledge()?;
+        assert_eq!(timeout(PATIENCE, exit_rx).await??, 3, "{path:?}");
+        assert_eq!(
+            timeout(PATIENCE, outcome).await??,
+            ObservationOutcome::Completed,
+            "{path:?}"
+        );
+        assert!(reaped(pid), "{path:?}");
+    }
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn the_bound_reaps_without_an_acknowledgement() -> anyhow::Result<()> {
+    let bound = Duration::from_millis(300);
+    for path in PATHS {
+        let (spawned, observed) = spawn_observed("exit 0", path, bound).await?;
+        let Observed {
+            opportunity,
+            outcome,
+        } = observed;
+        let opportunity = timeout(PATIENCE, opportunity).await??;
+        let published = Instant::now();
+
+        assert_eq!(timeout(PATIENCE, spawned.exit_rx).await??, 0, "{path:?}");
+        assert!(
+            published.elapsed() >= bound - Duration::from_millis(50),
+            "{path:?}"
+        );
+        assert_eq!(
+            timeout(PATIENCE, outcome).await??,
+            ObservationOutcome::TimedOut,
+            "{path:?}"
+        );
+        // An acknowledgement after the bound is refused.
+        assert_eq!(
+            opportunity.acknowledge(),
+            Err(OpportunityExpired),
+            "{path:?}"
+        );
+    }
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn a_dropped_opportunity_reaps_at_once() -> anyhow::Result<()> {
+    for path in PATHS {
+        let (spawned, observed) = spawn_observed("exit 0", path, PATIENCE).await?;
+        let Observed {
+            opportunity,
+            outcome,
+        } = observed;
+        let started = Instant::now();
+        drop(timeout(PATIENCE, opportunity).await??);
+
+        assert_eq!(timeout(PATIENCE, spawned.exit_rx).await??, 0, "{path:?}");
+        assert!(started.elapsed() < PATIENCE / 2, "{path:?}");
+        assert_eq!(
+            timeout(PATIENCE, outcome).await??,
+            ObservationOutcome::Failed,
+            "{path:?}"
+        );
+    }
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn a_dropped_observer_does_not_keep_the_child_unreaped() -> anyhow::Result<()> {
+    for path in PATHS {
+        let (spawned, observed) = spawn_observed("sleep 0.2; exit 0", path, PATIENCE).await?;
+        let started = Instant::now();
+        drop(observed);
+
+        assert_eq!(timeout(PATIENCE, spawned.exit_rx).await??, 0, "{path:?}");
+        assert!(started.elapsed() < PATIENCE / 2, "{path:?}");
+    }
+    Ok(())
+}
+
+/// A descendant that ignores the terminal's hangup outlives the root. While the exited root is
+/// unreaped, the descendant's process group is still the root's ID, so an observer can still
+/// attribute it.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn a_surviving_descendant_still_has_the_roots_group_in_the_window() -> anyhow::Result<()> {
+    for path in PATHS {
+        let (spawned, observed) = spawn_observed(
+            "trap '' HUP; sleep 30 & echo bg:$!; echo pid:$$; exit 0",
+            path,
+            PATIENCE,
+        )
+        .await?;
+        let SpawnedProcess {
+            mut stdout_rx,
+            exit_rx,
+            ..
+        } = spawned;
+        let Observed {
+            opportunity,
+            outcome,
+        } = observed;
+        let [descendant, pid] = marker_pids(&mut stdout_rx, ["bg:", "pid:"]).await?;
+
+        let opportunity = timeout(PATIENCE, opportunity).await??;
+        assert!(exited_unreaped(pid), "{path:?}");
+        assert!(alive(descendant), "{path:?}");
+        // SAFETY: getpgid only reads the process group of `descendant`.
+        assert_eq!(unsafe { libc::getpgid(descendant) }, pid, "{path:?}");
+
+        opportunity.acknowledge()?;
+        assert_eq!(timeout(PATIENCE, exit_rx).await??, 0, "{path:?}");
+        assert_eq!(
+            timeout(PATIENCE, outcome).await??,
+            ObservationOutcome::Completed,
+            "{path:?}"
+        );
+        // The reap does not end the descendant.
+        assert!(alive(descendant), "{path:?}");
+        // SAFETY: SIGKILL to the test's own descendant.
+        unsafe { libc::kill(descendant, libc::SIGKILL) };
+        assert!(ended(descendant).await, "{path:?}");
+    }
+    Ok(())
+}
+
+/// Termination while the exited root is unreaped reaches the whole group, and the child is
+/// still reaped once, by its waiter.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn terminate_in_the_window_kills_the_group_and_reaps_once() -> anyhow::Result<()> {
+    for path in PATHS {
+        let (spawned, observed) = spawn_observed(
+            "trap '' HUP; sleep 30 & echo bg:$!; echo pid:$$; exit 0",
+            path,
+            PATIENCE,
+        )
+        .await?;
+        let SpawnedProcess {
+            session,
+            mut stdout_rx,
+            exit_rx,
+            ..
+        } = spawned;
+        let Observed {
+            opportunity,
+            outcome,
+        } = observed;
+        let [descendant, pid] = marker_pids(&mut stdout_rx, ["bg:", "pid:"]).await?;
+
+        let opportunity = timeout(PATIENCE, opportunity).await??;
+        session.terminate();
+        assert!(ended(descendant).await, "{path:?}");
+        assert!(exited_unreaped(pid), "{path:?}");
+
+        opportunity.acknowledge()?;
+        assert_eq!(timeout(PATIENCE, exit_rx).await??, 0, "{path:?}");
+        assert_eq!(
+            timeout(PATIENCE, outcome).await??,
+            ObservationOutcome::Completed,
+            "{path:?}"
+        );
+        assert!(reaped(pid), "{path:?}");
+    }
+    Ok(())
+}
+
+/// Dropping the process handle in the window leaves the waiter to it: the child is reaped once,
+/// after the acknowledgement.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn a_handle_dropped_in_the_window_still_reaps_after_the_acknowledgement() -> anyhow::Result<()>
